# ===== Provider =====
# "langchain" or "llamaindex"
RAG_ENGINE=langchain

# LLM: "anthropic", "openai" or "ollama"
# Embeddings: "semantic" (sentence-transformers, semantic), "local-lite" (hashing, lexical), "openai" or "ollama"
LLM_PROVIDER=anthropic
EMBED_PROVIDER=local-lite

# Anthropic (only required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (only required if *_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here

# Ollama (only required if *_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Models
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
LOCAL_EMBED_DIMENSION=768
LOCAL_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===== Vector store =====
# "chroma" or "faiss"
VECTOR_STORE=chroma
CHROMA_DIR=./data/index/chroma
FAISS_DIR=./data/index/faiss

# ===== Chunking =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ===== Retrieval =====
TOP_K=4
SCORE_THRESHOLD=0.25

# ===== API =====
API_HOST=127.0.0.1
API_PORT=8000

# ===== SaaS authentication =====
# SQLite database for users and expiring Bearer sessions.
AUTH_DB_PATH=./data/auth.sqlite3
SESSION_TTL_HOURS=24

# ===== Security =====
# Optional shared secret enforced via the X-API-Key header.
# Leave empty to disable authentication (not recommended for non-local use).
RAG_API_KEY=

# Optional JSON map: API key -> allowed workspace IDs. When configured, it
# replaces the shared key for authorization. Use ["*"] for an administrator.
# RAG_API_KEY_WORKSPACES={"team-a-token":["team-a"],"admin-token":["*"]}
RAG_API_KEY_WORKSPACES={}

# ===== Workspace UI =====
# Workspace transmis par Streamlit via X-Workspace-ID.
RAG_WORKSPACE_ID=default

# ===== Uploads =====
MAX_UPLOAD_MB=20