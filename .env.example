# ===== Provider =====
# "langchain" or "llamaindex"
RAG_ENGINE=langchain

# LLM: "anthropic", "openai" or "ollama"
# Embeddings: "local", "openai" or "ollama"
LLM_PROVIDER=anthropic
EMBED_PROVIDER=local

# Anthropic (only required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (only required if *_PROVIDER=openai)
OPENAI_API_KEY=sk-your-key-here

# Ollama (only required if *_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Models
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
LOCAL_EMBED_DIMENSION=768

# ===== Vector store =====
# "chroma" or "faiss"
VECTOR_STORE=chroma
CHROMA_DIR=./data/index/chroma
FAISS_DIR=./data/index/faiss

# ===== Chunking =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ===== Retrieval =====
TOP_K=4
SCORE_THRESHOLD=0.25

# ===== API =====
API_HOST=127.0.0.1
API_PORT=8000

# ===== Uploads =====
MAX_UPLOAD_MB=20
